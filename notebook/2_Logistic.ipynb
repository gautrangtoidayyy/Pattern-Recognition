    "class LogisticRegressionNP:\n",
    "    def __init__(self, eta=1.0, lam=1e-4, max_epochs=40, tol=1e-7):\n",
    "        self.eta = eta               \n",
    "        self.lam = lam                \n",
    "        self.max_epochs = max_epochs  \n",
    "        self.tol = tol             \n",
    "\n",
    "    def fit(self, X, y):\n",
    "        Xb = add_bias(X)\n",
    "        t = (y > 0).astype(float)\n",
    "        N, d = Xb.shape\n",
    "        mask = np.ones(d)\n",
    "        mask[-1] = 0.0\n",
    "        self.w_ = np.zeros(d)\n",
    "        self.loss_ = [] \n",
    "        \n",
    "        for epoch in range(self.max_epochs):\n",
    "            z = Xb @ self.w_                                                                  \n",
    "            p = sigmoid(z)                                                                    \n",
    "            loss = np.mean(np.logaddexp(0, z) - t * z) + 0.5 * self.lam * np.sum((mask * self.w_) ** 2)  \n",
    "            grad = (Xb.T @ (p - t)) / N + self.lam * (mask * self.w_)                      \n",
    "            self.w_ = self.w_ - self.eta * grad                                           \n",
    "            self.loss_.append(loss)\n",
    "            \n",
    "            # Điều kiện dừng sớm khi độ suy giảm hàm mất mát nhỏ hơn ngưỡng tol\n",
    "            if epoch > 0 and abs(self.loss_[-2] - loss) < self.tol:\n",
    "                break\n",
    "        return self\n",
    "\n",
    "    def decision_function(self, X):\n",
    "        \"\"\"Tính điểm số hàm quyết định tuyến tính f(x) = x @ w.\"\"\"\n",
    "        return add_bias(X) @ self.w_\n",
    "\n",
    "    def predict_proba(self, X):\n",
    "        \"\"\"Tính xác suất mẫu thuộc về lớp dương P(y = +1 | x) qua hàm Sigmoid.\"\"\"\n",
    "        return sigmoid(self.decision_function(X))\n",
    "\n",
    "    def predict(self, X):\n",
    "        \"\"\"Dự đoán nhãn nhị phân: nếu f(x) >= 0 gán nhãn +1, ngược lại gán nhãn -1.\"\"\"\n",
    "        return np.where(self.decision_function(X) >= 0, 1, -1)\n",
    "\n",
    "\n",
    "class OneVsRest:\n",
    "    def __init__(self, eta=1.0, lam=1e-4, max_epochs=40, tol=1e-7):\n",
    "        self.eta = eta               \n",
    "        self.lam = lam                \n",
    "        self.max_epochs = max_epochs \n",
    "        self.tol = tol                \n",
    "\n",
    "    def fit(self, X, y):\n",
    "        self.classes_ = np.unique(y) \n",
    "        K = len(self.classes_)       \n",
    "        N, d = X.shape               \n",
    "        Xb = add_bias(X)\n",
    "        \n",
    "        T = np.zeros((N, K), dtype=float)\n",
    "        for idx, c in enumerate(self.classes_):\n",
    "            T[:, idx] = (y == c).astype(float)\n",
    "        mask = np.ones((d + 1, 1), dtype=float)\n",
    "        mask[-1] = 0.0\n",
    "        \n",
    "        self.W_ = np.zeros((d + 1, K), dtype=float)\n",
    "        self.loss_history_ = []  \n",
    "        \n",
    "        for epoch in range(self.max_epochs):\n",
    "            Z = Xb @ self.W_\n",
    "            P = sigmoid(Z)   \n",
    "            \n",
    "            loss_k = np.mean(np.logaddexp(0, Z) - T * Z, axis=0) + 0.5 * self.lam * np.sum((mask * self.W_) ** 2, axis=0)\n",
    "            mean_loss = float(np.mean(loss_k))\n",
    "            self.loss_history_.append(mean_loss)\n",
    "            \n",
    "            grad = (Xb.T @ (P - T)) / N + self.lam * (mask * self.W_)\n",
    "            self.W_ -= self.eta * grad  # Cập nhật song song cả 10 bộ trọng số\n",
    "            \n",
    "            # Dừng sớm nếu hàm mất mát không đổi đáng kể\n",
    "            if epoch > 0 and abs(self.loss_history_[-2] - mean_loss) < self.tol:\n",
    "                break\n",
    "            \n",
    "        class BinaryModelView:\n",
    "            def __init__(self, w, loss):\n",
    "                self.w_ = w\n",
    "                self.loss_ = loss\n",
    "            def decision_function(self, X_in):\n",
    "                return add_bias(X_in) @ self.w_\n",
    "                \n",
    "        self.models_ = [BinaryModelView(self.W_[:, i], self.loss_history_) for i in range(K)]\n",
    "        return self\n",
    "\n",
    "    def decision_function(self, X):\n",
    "        \"\"\"Trả về ma trận điểm số quyết định kích thước (N, 10) của 10 chữ số.\"\"\"\n",
    "        return add_bias(X) @ self.W_\n",
    "\n",
    "    def predict_proba(self, X):\n",
    "        \"\"\"\n",
    "        Chuyển đổi điểm số tuyến tính thành phân phối xác suất đa lớp bằng hàm Softmax.\n",
    "        \"\"\"\n",
    "        scores = self.decision_function(X)\n",
    "        z_max = np.max(scores, axis=1, keepdims=True)  # Ổn định số học tránh tràn số exp\n",
    "        ez = np.exp(scores - z_max)\n",
    "        return ez / np.sum(ez, axis=1, keepdims=True)\n",
    "\n",
    "    def predict(self, X):\n",
    "        \"\"\"Quy tắc quyết định đa lớp: Chọn chữ số có điểm số decision_function cao nhất (argmax).\"\"\"\n",
    "        return self.classes_[np.argmax(self.decision_function(X), axis=1)]\n",
    "\n",
    "print(\"✔ Lớp LogisticRegressionNP và OneVsRest đã sẵn sàng!\")\n"
