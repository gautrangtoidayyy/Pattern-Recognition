    "def add_bias(X):\n",
    "    return np.hstack([X, np.ones((X.shape[0], 1), dtype=X.dtype)])\n",
    "\n",
    "\n",
    "def sigmoid(z):\n",
    "    out = np.empty_like(z, dtype=float)\n",
    "    pos = z >= 0\n",
    "    out[pos] = 1.0 / (1.0 + np.exp(-z[pos]))\n",
    "    ez = np.exp(z[~pos])\n",
    "    out[~pos] = ez / (1.0 + ez)\n",
    "    return out\n",
    "\n",
    "print(\"Các hàm toán học bổ trợ (add_bias, sigmoid) đã sẵn sàng!\")\n"
