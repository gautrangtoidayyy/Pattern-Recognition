    "# BẢNG PHÂN TÍCH HIỆU NĂNG CHI TIẾT TỪNG CHỮ SỐ (TEST SET)\n",
    "digit_records_lr = []\n",
    "total_test_samples = len(y_test)\n",
    "\n",
    "for c in range(10):\n",
    "    tp = int(cm_test_lr[c, c])                                   \n",
    "    fn = int(np.sum(cm_test_lr[c, :]) - tp)                          \n",
    "    fp = int(np.sum(cm_test_lr[:, c]) - tp)                        \n",
    "    tn = int(total_test_samples - tp - fn - fp)                    \n",
    "    \n",
    "    prec = tp / (tp + fp) * 100 if (tp + fp) > 0 else 0.0          \n",
    "    rec  = tp / (tp + fn) * 100 if (tp + fn) > 0 else 0.0            \n",
    "    f1   = 2 * prec * rec / (prec + rec) if (prec + rec) > 0 else 0.0 \n",
    "    support = tp + fn                                           \n",
    "    \n",
    "    digit_records_lr.append({\n",
    "        \"Chữ số\": c,\n",
    "        \"TP\": tp, \"FP\": fp, \"FN\": fn, \"TN\": tn,\n",
    "        \"Precision (%)\": round(prec, 2),\n",
    "        \"Recall (%)\": round(rec, 2),\n",
    "        \"F1-score (%)\": round(f1, 2),\n",
    "        \"Số mẫu (Support)\": support\n",
    "    })\n",
    "\n",
    "df_digits_lr = pd.DataFrame(digit_records_lr)\n",
    "print(\"--- BẢNG ĐÁNH GIÁ CHI TIẾT TỪNG CHỮ SỐ TRÊN TẬP TEST (LOGISTIC REGRESSION) ---\")\n",
    "display(df_digits_lr)\n"
